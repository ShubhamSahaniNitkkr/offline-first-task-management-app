---
import Meta from '../components/Meta.astro';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const apiBaseUrl = import.meta.env.PUBLIC_API_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <Meta title={title} />
    {apiBaseUrl && <meta name="api-base-url" content={apiBaseUrl} />}
  </head>
  <body>
    <slot />
  </body>
</html>
